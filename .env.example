# Copy this file to `.env` and adjust as needed. Every value is optional.
# Never put real keys in this file: it is committed to git. Use `.env` (git-ignored).

# HTTP port for the API server (and the built UI in production mode).
PORT=4000

# SQLite database location.
DB_PATH=./data/testforge.db

# --- AI root-cause analysis, test generation & fixes --------------------------
# Without a key, TestForge uses its built-in heuristic / rule-based engines.
# Provider: auto (Gemini if GEMINI_API_KEY is set, else Claude if ANTHROPIC_API_KEY
# is set), or force one with gemini | claude | none.
AI_PROVIDER=auto

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Tried in order when the main model is overloaded or out of quota.
GEMINI_FALLBACK_MODELS=gemini-flash-lite-latest

# Anthropic Claude (optional alternative)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
AI_EFFORT=medium
AI_FALLBACKS=default

# --- Demo data ---------------------------------------------------------------
# Number of real runs executed against the built-in demo API on first boot,
# so the dashboard has history to show. Set to 0 to start empty.
SEED_DEMO_RUNS=4

# --- Notifications -----------------------------------------------------------
# Base URL used for "Open run" links in Slack / Teams / webhook messages.
PUBLIC_URL=
